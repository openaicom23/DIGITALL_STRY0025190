<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false"
    xmlns:j="jelly:core"
    xmlns:g="glide"
    xmlns:j2="null"
    xmlns:g2="null">

    <!--
      UI Macro name: customer_account_highlights_history
      Formatter table: customer_account
      Both dictionary fields need Audit = true.
    -->

    <g:evaluate var="jvar_audit" object="true" jelly="true">
        var audit = new GlideRecord('sys_audit');
        audit.addQuery('tablename', current.getTableName());
        audit.addQuery('documentkey', current.getUniqueValue());
        var fields = audit.addQuery('fieldname', 'u_highlights');
        fields.addOrCondition('fieldname', 'u_highlits_explination');
        audit.orderByDesc('sys_created_on');
        audit.query();
        audit;
    </g:evaluate>

    <g:evaluate var="jvar_has_history" jelly="true">
        jvar_audit.hasNext();
    </g:evaluate>

    <tr>
        <td colspan="2">
            <div class="section-content" style="padding: 10px;">
                <h4 style="margin: 0 0 8px 0;">Highlights field history</h4>

                <j:if test="${jvar_has_history}">
                    <table class="table table-striped table-hover" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>User</th>
                                <th>Field</th>
                                <th>Old value</th>
                                <th>New value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <j:while test="${jvar_audit.next()}">
                                <g:evaluate var="jvar_field_label" jelly="true">
                                    var fn = jvar_audit.getValue('fieldname') + '';
                                    var el = current.getElement(fn);
                                    el ? el.getLabel() : fn;
                                </g:evaluate>
                                <g:evaluate var="jvar_user_name" jelly="true">
                                    var uname = jvar_audit.getValue('user') + '';
                                    var user = new GlideRecord('sys_user');
                                    (uname &amp;&amp; user.get('user_name', uname)) ? user.getDisplayValue() : uname;
                                </g:evaluate>
                                <tr>
                                    <td>${jvar_audit.getDisplayValue('sys_created_on')}</td>
                                    <td>${HTML:jvar_user_name}</td>
                                    <td>${HTML:jvar_field_label}</td>
                                    <td style="white-space: pre-wrap;">${HTML:jvar_audit.oldvalue}</td>
                                    <td style="white-space: pre-wrap;">${HTML:jvar_audit.newvalue}</td>
                                </tr>
                            </j:while>
                        </tbody>
                    </table>
                </j:if>
                <j:if test="${!jvar_has_history}">
                    <p style="margin: 0; color: #666;">No history for Highlights / Highlights explanation.</p>
                </j:if>
            </div>
        </td>
    </tr>
</j:jelly>
